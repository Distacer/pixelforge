# Docker Compose підхопить .env автоматично; для локального запуску бекенду
# ці змінні можна задати в конфігурації запуску PyCharm (Environment variables).

# Секрет для підпису JWT. Будь-який довгий випадковий рядок, наприклад:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Скільки живе токен (хвилин). 10080 = 7 днів
JWT_EXPIRE_MINUTES=10080

# Лише для локального запуску бекенду без Docker:
# DATABASE_URL=sqlite:///./data/pixelforge.db
# CORS_ORIGINS=http://localhost:5173
